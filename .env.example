# Used when running the API locally (outside Docker) against the compose services.
DATABASE_URL=postgresql+psycopg://bookstore:bookstore@localhost:5432/bookstore
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Mailpit (SMTP for development, web UI on http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin account created by `python -m app.seed`
ADMIN_EMAIL=admin@bookstore.dev
ADMIN_PASSWORD=admin12345
